/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.meltpet.com https:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'

# API: never cache, never index.
# Functions 响应本身不被 Pages 边缘缓存，但浏览器会 —— 显式声明比依赖默认行为可靠。
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Admin console: extensionless URL, so this must be an exact rule
# (the /*.html rule below never matches extensionless URLs)
/gallery-admin
  X-Robots-Tag: noindex, nofollow, noarchive

# HTML: short cache, must revalidate
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# CSS / JS: 1-week cache (versioned via query string)
/style.css
  Cache-Control: public, max-age=604800, must-revalidate

/nav.js
  Cache-Control: public, max-age=604800, must-revalidate

# Pin 详情页专用样式（只在 /gallery/<slug> 用，故意不并进 style.css，
# 免得每改一次都要全站升 ?v=）。版本号走 query，同 style.css 的口径。
/pin.css
  Cache-Control: public, max-age=604800, must-revalidate

# Images: 1-day cache
/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

# XML / data files: short cache
/*.xml
  Cache-Control: public, max-age=3600

# Manifest: 1-day cache
/manifest.json
  Cache-Control: public, max-age=86400
